# The Movie Database (TMDB) API Configuration
# Get your API key/token from: https://www.themoviedb.org/settings/api
EXPO_PUBLIC_API_KEY=your_tmdb_api_read_access_token_here

# Appwrite Cloud Configuration
# Create a project and database at: https://cloud.appwrite.io
EXPO_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
EXPO_PUBLIC_APPWRITE_PROJECT_ID=your_appwrite_project_id
EXPO_PUBLIC_APPWRITE_DATABASE_ID=your_appwrite_database_id
EXPO_PUBLIC_APPWRITE_FAVORITES_COLLECTION_ID=favorites
